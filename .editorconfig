# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[**/*.go]
indent_style = tab
indent_size = 4

[**/*.{yml,yaml,toml,json,jsonc}]
indent_style = space
indent_size = 2

[**/*.sh]
indent_style = tab
indent_size = 4